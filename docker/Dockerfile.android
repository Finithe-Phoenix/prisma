FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_HOME=/opt/android-sdk
ENV PATH="${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/emulator:${ANDROID_HOME}/platform-tools:${PATH}"

# Install Java and dependencies
RUN apt-get update && apt-get install -y \
    openjdk-17-jdk \
    wget \
    unzip \
    git \
    curl \
    qemu-kvm \
    libvirt-daemon-system \
    libvirt-clients \
    bridge-utils \
    && rm -rf /var/lib/apt/lists/*

# Download and install Android command-line tools
RUN mkdir -p ${ANDROID_HOME}/cmdline-tools && \
    cd ${ANDROID_HOME}/cmdline-tools && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -O cmdline-tools.zip && \
    unzip -q cmdline-tools.zip && \
    rm cmdline-tools.zip && \
    mv cmdline-tools latest

# Accept licenses
RUN yes | sdkmanager --licenses >/dev/null

# Install SDK packages, NDK, and system image
# Note: Using NDK 26 as a stable default.
RUN sdkmanager \
    "platform-tools" \
    "platforms;android-33" \
    "emulator" \
    "ndk;26.1.10909125" \
    "system-images;android-33;google_apis;arm64-v8a"

# Create AVD (Android Virtual Device)
RUN echo "no" | avdmanager create avd -n docker_avd -k "system-images;android-33;google_apis;arm64-v8a"

EXPOSE 5555
EXPOSE 5037

# Start emulator
# -no-window: No GUI
# -no-audio: Disable audio
# -no-boot-anim: Disable boot animation for faster boot
# -gpu swiftshader_indirect: Software rendering for Docker environments
CMD ["emulator", "-avd", "docker_avd", "-no-window", "-no-audio", "-no-boot-anim", "-gpu", "swiftshader_indirect"]
